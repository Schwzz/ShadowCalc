<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvSubDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/gray_text"
        android:textSize="24sp"
        android:gravity="end"
        android:padding="8dp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="56sp"
        android:gravity="end|bottom"
        android:padding="16dp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="end" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="5"
        android:paddingTop="16dp">

        <Button android:id="@+id/btnClear" style="@style/CalcButton.Operator" android:text="C" />
        <Button android:id="@+id/btnDelete" style="@style/CalcButton.Operator" android:text="⌫" />
        <Button android:id="@+id/btnDivide" style="@style/CalcButton.Operator" android:text="÷" />
        <Button android:id="@+id/btnMultiply" style="@style/CalcButton.Operator" android:text="×" />

        <Button android:id="@+id/btn7" style="@style/CalcButton.Number" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/CalcButton.Number" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/CalcButton.Number" android:text="9" />
        <Button android:id="@+id/btnMinus" style="@style/CalcButton.Operator" android:text="−" />

        <Button android:id="@+id/btn4" style="@style/CalcButton.Number" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/CalcButton.Number" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/CalcButton.Number" android:text="6" />
        <Button android:id="@+id/btnPlus" style="@style/CalcButton.Operator" android:text="+" />

        <Button android:id="@+id/btn1" style="@style/CalcButton.Number" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/CalcButton.Number" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/CalcButton.Number" android:text="3" />
        <Button android:id="@+id/btnEquals" style="@style/CalcButton.Equals" android:text="=" android:layout_rowSpan="2" />

        <Button android:id="@+id/btn0" style="@style/CalcButton.Number" android:text="0" android:layout_columnSpan="2" />
        <Button android:id="@+id/btnDot" style="@style/CalcButton.Number" android:text="." />

    </GridLayout>
</LinearLayout>
