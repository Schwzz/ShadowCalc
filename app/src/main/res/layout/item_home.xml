<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center"
    android:padding="16dp" android:layout_margin="8dp" android:background="@drawable/bg_card">
    <ImageView android:id="@+id/ivIcon" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="8dp" />
    <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/white" android:textSize="14sp" />
</LinearLayout>