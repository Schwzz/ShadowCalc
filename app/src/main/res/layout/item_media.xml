<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="120dp"
    android:layout_margin="4dp" android:background="@drawable/bg_card">
    <ImageView android:id="@+id/ivThumb" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
    <ImageView android:id="@+id/btnDelete" android:layout_width="32dp" android:layout_height="32dp"
        android:layout_gravity="top|end" android:layout_margin="4dp" android:src="@drawable/ic_delete"
        android:padding="6dp" android:background="@drawable/bg_circle" android:contentDescription="Delete" />
</FrameLayout>